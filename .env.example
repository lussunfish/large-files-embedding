# 공유 인프라 자격은 ~/dev/00.workspace/01-stable 의 .env / README 를 따른다.

LOG_LEVEL=info
DATA_DIR=./data

# 공유 Milvus (01-stable/local-milvus) — Lite 파일 아님
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=market_quality_chunks_hybrid

# 공유 MariaDB (01-stable/local-mariadb) — 표 2층. embeddings.chunks VECTOR 금지
MARIADB_HOST=127.0.0.1
